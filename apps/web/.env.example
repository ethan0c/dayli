# Semli site (apps/web). Server-side only; nothing here reaches the browser.

# Claude API key for /api/extract. Get one at https://platform.claude.com
ANTHROPIC_API_KEY=

# Supabase, same project as the app: import limits and the beta waitlist. Publishable key only.
SUPABASE_URL=
SUPABASE_KEY=

# RevenueCat secret key: lib/import-access.ts checks a subscriber's entitlement before a paid import.
# Required in production; imports for Plus users fail the entitlement check without it.
#REVENUECAT_SECRET_KEY=

# TestFlight invite link; /beta redirects there once set. Leave unset until the first build is up.
#TESTFLIGHT_URL=
