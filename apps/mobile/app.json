{
  "expo": {
    "name": "Semli",
    "slug": "semli",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "semli",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.semli.mobile",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Semli uses the camera to read printed schedules.",
        "NSPhotoLibraryUsageDescription": "Semli reads screenshots of schedules and syllabi you choose.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF9F6",
          "image": "./assets/images/splash-icon-light.png",
          "dark": {
            "backgroundColor": "#7057BD",
            "image": "./assets/images/splash-icon.png"
          },
          "imageWidth": 240,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Semli reads screenshots of schedules and syllabi you choose.",
          "cameraPermission": "Semli uses the camera to read printed schedules."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-localization",
      "@sentry/react-native/expo",
      [
        "expo-media-library",
        {
          "photosPermission": "Semli shows your recent screenshots so you can add a schedule in one tap. Nothing leaves your phone until you confirm.",
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "629299e1-defe-46c5-8110-0b0e9c787ffc"
      }
    },
    "owner": "ethanlma"
  }
}
