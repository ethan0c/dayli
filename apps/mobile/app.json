{
  "expo": {
    "name": "Dayli",
    "slug": "nowli",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nowli",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.nowli.mobile",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Dayli uses the camera to read printed schedules.",
        "NSPhotoLibraryUsageDescription": "Dayli reads screenshots of schedules and syllabi you choose."
      }
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1C1B21",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Dayli reads screenshots of schedules and syllabi you choose.",
          "cameraPermission": "Dayli uses the camera to read printed schedules."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
