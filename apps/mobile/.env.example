# Semli mobile (apps/mobile). Expo inlines every EXPO_PUBLIC_* value into the app bundle, so none
# of them is secret, but EAS cloud builds do not read this file: push them with
#   npx eas-cli env:push --environment production --environment preview --path .env.production
# (see docs/app-store-connect.md). Local release builds read this file directly.

# Site that runs imports. Production: https://semli.app
EXPO_PUBLIC_API_URL=

# Accounts and backup (Supabase). Publishable key only; never the secret key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=

# Subscriptions (RevenueCat). Android key stays off until there is an Android build.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_CUSTOMER_CENTER_ENABLED=
#EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# Analytics (PostHog)
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=

# Crash reporting (Sentry, project semli-mobile). The DSN ships in the app; the auth token is only
# for the build step that uploads source maps and dSYMs. Keep the token secret.
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Not used by the app. Supabase tooling only: the database password for `supabase db push`, and the
# Resend API key that is the SMTP password in the Supabase dashboard (supabase/templates/README.md).
#DATABASE_PASSWORD=
#RESEND_API_KEY=
