# Where the Semli web app (and its /api/extract route) is running.
# iOS simulator can use localhost; a real phone needs your computer's LAN address.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Debug development builds use Semli's public RevenueCat Test Store key automatically.
# Release builds require the matching app-specific public SDK key (never a secret sk_ key).
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
# Enable only after configuring Customer Center in RevenueCat (eligible plan required).
# Otherwise Manage subscription opens CustomerInfo.managementURL in the store.
EXPO_PUBLIC_REVENUECAT_CUSTOMER_CENTER_ENABLED=false

# Product analytics (PostHog project API key, public). Leave empty to keep everything on the device.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Crash reports. Leave empty to disable Sentry.
EXPO_PUBLIC_SENTRY_DSN=

# Accounts and backup (Supabase). Leave empty and Semli is guest-only, with no account screens.
# Project Settings → API: the project URL and the publishable key (sb_publishable_…, never the secret key).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=
